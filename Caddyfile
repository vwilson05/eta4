{
	admin off
	auto_https off
}

:{$PORT}

root * /srv
encode gzip zstd
file_server

# Long cache for static assets, short for HTML so edits show up quickly
@assets path *.css *.js *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff *.woff2
header @assets Cache-Control "public, max-age=86400"
header /* Cache-Control "public, max-age=300"
header X-Content-Type-Options nosniff
header Referrer-Policy strict-origin-when-cross-origin
